# Base URL of the FastAPI backend (no trailing slash, and no /api suffix).
# The client appends /api to every request in all environments.
#
# Production (Vercel Services): leave this unset. The backend and frontend
# are served from the same origin and requests go to /api via the rewrite,
# so no cross-origin URL or CORS configuration is needed.
#
# Local development: point this at the local backend, which serves the
# same /api-prefixed paths.
VITE_API_BASE_URL=http://localhost:8000
