# Backend environment variables (copy to backend/.env and fill in).
# Every value below is a safe placeholder or default. NEVER commit a
# real .env file or real secrets -- only this example is tracked.

# --- AI agent provider (optional) -------------------------------------
# Leave LLM_API_KEY empty to run the deterministic offline fallback.
# When set, the key is used server-side only and is never sent to the
# frontend or written to logs.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- CORS -------------------------------------------------------------
# Comma-separated list of allowed browser origins for the API.
# When unset, local development defaults are used:
#   http://localhost:5173,http://127.0.0.1:5173
# For production, list your deployed frontend origin explicitly.
# Wildcards ("*") are rejected.
CORS_ORIGINS=

# --- Server (optional) ------------------------------------------------
# PORT is provided automatically by most hosts (Render, Railway, etc.).
# LOG_LEVEL controls Uvicorn log verbosity (info, debug, warning).
PORT=8000
LOG_LEVEL=info
